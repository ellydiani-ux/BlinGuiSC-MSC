}
Serial.print("count4: "); 
Serial.println(countUlt);   


     
  }
  
  
  
 void sonarSpeed(){

   lastDistFront = sonarCalcDistance(trigPin1, echoPin1);
   lastTime = millis();
   currentDistFront = sonarCalcDistance(trigPin1, echoPin1);
   currentTime = millis();

   variatDist = abs(lastDistFront - currentDistFront); 
   variatTime = abs(currentTime-lastTime);
   
   speeds = (variatDist)/ (variatTime);  
     
   dowSensor = sonarCalcDistance(trigPin2, echoPin2);
   upSensor = sonarCalcDistance(trigPin3, echoPin3);

Serial.print("lastDistFront: ");        
Serial.print(lastDistFront);   
Serial.print("currentDistFront: ");        
Serial.print(currentDistFront);  
Serial.print("variatDist: "); 
Serial.print(variatDist);   

Serial.print("speeds: "); 
Serial.println(speeds);   
   dataFile = SD.open("dataU.csv", FILE_WRITE);

   if (dataFile) {
       
       dataFile.print("speeds:,");
       dataFile.print(speeds);
        
       dataFile.print(", variatDist, ");
       dataFile.print(variatDist);
      
       dataFile.print(", variatTime, ");
       dataFile.print(variatTime);
            
       dataFile.print(", DistFront, ");
       dataFile.print(currentDistFront);
      
       dataFile.print(", DistDow, ");
       dataFile.print(dowSensor);
       
       dataFile.print(", DistUp, ");
       dataFile.print(upSensor);
       
       dataFile.println(",stop/oneDirection");
       // close the file:
      dataFile.flush();
      dataFile.close();    
       }
      else {
      // if the file didn't open, print an error:
      Serial.println("error opening dataU.csv");
      }
    
  }
  
          
void meansensorAccel(){
  long i=0,buff_ax=0,buff_ay=0,buff_az=0,buff_gx=0,buff_gy=0,buff_gz=0;

  while (i<(buffersize+101)){
    // read raw accel/gyro measurements from device
 Wire.beginTransmission(MPU_addr);
 Wire.write(0x3B);  // starting with register 0x3B (ACCEL_XOUT_H)
 Wire.endTransmission(false);
 Wire.requestFrom(MPU_addr,14,true);  // request a total of 14 registers
 ax=Wire.read()<<8|Wire.read();  // 0x3B (ACCEL_XOUT_H) & 0x3C (ACCEL_XOUT_L)  
 ay=Wire.read()<<8|Wire.read();  // 0x3D (ACCEL_YOUT_H) & 0x3E (ACCEL_YOUT_L)
 az=Wire.read()<<8|Wire.read();  // 0x3F (ACCEL_ZOUT_H) & 0x40 (ACCEL_ZOUT_L)
      
    if (i>100 && i<=(buffersize+100)){ //First 100 measures are discarded
      buff_ax=buff_ax+ax;
      buff_ay=buff_ay+ay;
      buff_az=buff_az+az;
    }
    if (i==(buffersize+100)){
      int ready=0;
      
      mean_ax=buff_ax/buffersize;
      mean_ay=buff_ay/buffersize;
      mean_az=buff_az/buffersize;
      
      ax_offset=-mean_ax/8;
      ay_offset=-mean_ay/8;
      az_offset=(16384-mean_az)/8;
    
     if (abs(mean_ay)<=acel_deadzone) ready++;
    else ay_offset=ay_offset-mean_ay/acel_deadzone;

    if (abs(16384-mean_az)<=acel_deadzone) ready++;
    else az_offset=az_offset+(16384-mean_az)/acel_deadzone;
    
    if (abs(mean_ax)<=acel_deadzone){
           Serial.print("\t entrou:");
           ready++;}
    else {
     ax_offset=ax_offset-mean_ax/acel_deadzone;
     currentRead = ax_offset;
    Serial.print("\t x1:");
    Serial.print(ax_offset);
        diff= abs(currentRead - lastRead);
    }
    lastRead = currentRead;
   
   // Serial.print("Diferenca:");
   // Serial.println(diff);
      
   dataFile = SD.open("dataAc.csv", FILE_WRITE);

   if (dataFile) {
       dataFile.print("x|y|z:,{");
       dataFile.print(ax_offset);
       
       //dataFile.print(",diffAcX:,");
       //dataFile.print(diff);
       
       dataFile.print("; ");
       dataFile.print(ay_offset);

       dataFile.print("; ");
       dataFile.print(az_offset);
       
       dataFile.println("},stop/move/seat");
       // close the file:
      dataFile.flush();
      dataFile.close();    
       }
      else {
      // if the file didn't open, print an error:
      Serial.println("error opening dataAcc.csv");
    }
       
    if (ready==3) break;
    }
    i++;
  }
}



