//-----------------------------------------------------------------------
// Configuracion del microcontrolador
//-----------------------------------------------------------------------


void setup() {
    Serial.begin(9600);
   a.pinAccelerometer();
   u.pinSonar();
   s.pinSound();
   n.pinNotification();
  Serial.begin(9600);

}




//-----------------------------------------------------------------------
// Programa principal
//-----------------------------------------------------------------------
void loop() {    
 if (n.notificOff()==true){
  if (classifAccelerometer()==true){
    n.lightActivity();
  ObstacleDetection();
 }
}
}
